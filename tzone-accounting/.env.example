# Backend ---------------------------------------------------------------
ACCOUNTING_DB_PATH=./data/accounting.db
ACCOUNTING_JWT_SECRET=change-me-before-any-real-deployment
ACCOUNTING_JWT_TTL_MINUTES=720
ACCOUNTING_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Seed admin (used only by `python -m app.seed`)
ACCOUNTING_ADMIN_USERNAME=admin
ACCOUNTING_ADMIN_PASSWORD=admin123

# Install a subset of modules. Dependencies are pulled in automatically; leave empty for all.
# e.g. ACCOUNTING_MODULES=reports  ->  base + accounting + reports only
ACCOUNTING_MODULES=

# Frontend --------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8010
