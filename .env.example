# =============================================================================
# T-ZONE Platform — environment template
# =============================================================================
# Copy to .env for local development, or to /etc/tzone/tzone.env on a server
# (that is the file the systemd unit loads with EnvironmentFile).
#
#   cp .env.example .env
#
# Every variable below is read by config/settings.py. Anything not listed here
# is not read by the application. Blank values fall back to the defaults shown
# in the comments, so you only need to fill in what you actually want to change.
#
# NEVER commit a filled-in copy of this file. .env is gitignored; keep it that
# way. The placeholder values here are deliberately not valid secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# MANDATORY IN PRODUCTION
# -----------------------------------------------------------------------------

# The server master key. It unwraps the encryption key of every company
# database, so the platform cannot open a single database without it.
#
# Generate one with:
#     python -m tools.manage_platform generate-master-key
#
# WARNING: there is no recovery path. If this value is lost, every company
# database — and every backup of one — is permanently unreadable. Keep an
# offline copy somewhere separate from the server and from the backups.
# Never regenerate it for a platform that already holds data.
TZONE_MASTER_KEY=

# Meta app secret, from the Meta app dashboard under Settings > Basic.
# It verifies the X-Hub-Signature-256 header on inbound Messenger, Instagram
# and WhatsApp webhooks. Without it, any host on the internet can post fake
# customer messages into the platform, so an unset secret is treated as a hard
# rejection rather than a skipped check.
META_APP_SECRET=

# Only set this if WhatsApp is registered under a different Meta app than
# Messenger/Instagram. Defaults to META_APP_SECRET when left blank.
WHATSAPP_APP_SECRET=


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# development | production. Setting it to production turns the interactive API
# docs off by default and is what config.is_production reports.
APP_ENV=development

# Verbose error output. Leave off in production.
# Default: false
DEBUG=false

# DEBUG | INFO | WARNING | ERROR
# Default: INFO
LOG_LEVEL=INFO

# Fallback language when a customer's language cannot be detected.
# Default: ar
DEFAULT_LANGUAGE=ar

# Platform operator name, used in operator-facing output.
# Default: T-ZONE
COMPANY_NAME=T-ZONE


# -----------------------------------------------------------------------------
# PATHS
# -----------------------------------------------------------------------------
# Relative values are resolved against the project root, not the working
# directory, so the application behaves the same under systemd as it does when
# started by hand. Absolute paths are used as given.
#
# On a server, DATA_DIR and LOG_DIR must match the ReadWritePaths entries in
# deploy/tzone-api.service — ProtectSystem=strict makes everything else
# read-only, and the service will fail to write anywhere you forget to list.

# Holds control.db and tenants/company_<id>.db — all the encrypted databases.
# This is the directory that must be backed up.
# Default: <project root>/data
DATA_DIR=data

# Default: <project root>/logs
LOG_DIR=logs

# Default: <project root>/features
FEATURES_DIR=features

# Default: <project root>/config
CONFIG_DIR=config

# Default: <project root>/data/uploads
UPLOAD_DIR=data/uploads

# Default: <project root>/data/media
MEDIA_DIR=data/media


# -----------------------------------------------------------------------------
# HTTP SURFACE
# -----------------------------------------------------------------------------

# Comma-separated browser origins allowed to call the API. In production this
# is the dashboard's own https origin and nothing else — a wildcard here would
# let any site make authenticated requests on a logged-in user's behalf.
# Default: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Serve /docs and /redoc. The interactive docs map the whole attack surface, so
# they stay off in production.
#
# Left COMMENTED on purpose, and it is the one variable in this file where that
# matters. Setting it at all defeats the default below, because the default is
# the only thing that knows which environment this is -- and deploy/install.sh
# copies this file to the production env file, so a pinned `true` here shipped
# /docs, /redoc and /openapi.json on every install made from these
# instructions, three lines under a comment saying they stay off in production.
# Uncomment it only to force docs ON in a production environment, deliberately.
#
# Default: true outside production, false in production
# ENABLE_DOCS=true

# Lifetime of a login session, in minutes. Default: 720 (12 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Failed logins allowed before an account is locked out. Default: 5
LOGIN_MAX_ATTEMPTS=5

# Failures from one address before that address is throttled. Deliberately far
# above LOGIN_MAX_ATTEMPTS: a whole office shares one address, so throttling it
# as tightly as an account would mean one colleague's typos lock out everyone
# sitting near them. Default: 20
LOGIN_ADDRESS_MAX_ATTEMPTS=20

# How long that lockout lasts, in minutes. Default: 30
# A locked account does not have to wait this out: an administrator holding
# `users.manage` can send a password-reset link, which unlocks it immediately.
LOGIN_LOCKOUT_MINUTES=30

# How long a password-reset link stays usable, in minutes. Default: 30
PASSWORD_RESET_TTL_MINUTES=30


# -----------------------------------------------------------------------------
# OUTBOUND EMAIL
# -----------------------------------------------------------------------------
# Used for password-reset links and security notices.
#
# There is no second channel. If this is not configured, the endpoints that
# need it refuse with a clear message rather than reporting success for a mail
# nobody will receive — and the operator CLI stays the way back in:
#   python -m tools.manage_platform reset-password --email someone@example.com

# smtp | console | disabled
#   smtp     — send for real, using the settings below.
#   console  — write the message to the application log. Development and tests.
#   disabled — refuse to send at all.
# Default: console
EMAIL_BACKEND=console

# Your mail provider. A Gmail account needs an App Password, not the account
# password. Whatever you use, set SPF and DKIM on the sending domain or a good
# share of these will land in spam — a reset link in a spam folder is an
# employee who cannot get back in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The From address. Must be one your provider will let you send as.
SMTP_FROM=

# STARTTLS on port 587 (the usual). Turn this off only for a local relay that
# does not speak TLS. Default: true
SMTP_STARTTLS=true

# Seconds to wait on the mail server before giving up. Default: 20
SMTP_TIMEOUT_SECONDS=20

# The origin a browser reaches this platform on, with no trailing slash.
# Password-reset links are built from it, so a wrong value produces links that
# go nowhere. Default: http://localhost:5173
APP_PUBLIC_URL=https://app.example.com


# -----------------------------------------------------------------------------
# WEBHOOK SECURITY
# -----------------------------------------------------------------------------

# Accept webhooks whose signature is missing or wrong. This exists only for
# local testing against tools that cannot sign requests. Turning it on in
# production means anyone can inject messages as any customer.
# Default: false
ALLOW_UNSIGNED_WEBHOOKS=false

# The previous app secret, during a rotation only. Meta signs with whichever
# secret was current when it queued the delivery, so without an overlap every
# rotation drops the events already in flight. Set this to the old value, let
# it run until the log stops reporting matches against it, then clear it.
META_APP_SECRET_PREVIOUS=
WHATSAPP_APP_SECRET_PREVIOUS=


# -----------------------------------------------------------------------------
# HARD PLATFORM CEILINGS
# -----------------------------------------------------------------------------
# One set of numbers for everybody, and deliberately not for sale. These protect
# the process itself, so no subscription plan may raise them. Commercial
# per-plan quotas sit inside these, never above them.

# Largest webhook body the application will read, in bytes. Enforced here and
# not only in nginx, so a deployment that never sees the proxy is still bounded.
# Default: 5242880 (5 MB)
WEBHOOK_MAX_BODY_BYTES=5242880

# Most events one signed request may carry. Meta batches in tens.
# Default: 1000
WEBHOOK_MAX_EVENTS=1000

# Most messages one pending reply batch may accumulate before it is delivered
# as it stands. Default: 50
PENDING_REPLY_MAX_MESSAGES=50

# Longest a batch may be deferred by new arrivals. Every message pushes the
# delivery time out, so without this a sustained flood at one customer keeps
# its batch waiting forever. Default: 300 (5 minutes)
PENDING_REPLY_MAX_DEFERRAL_SECONDS=300

# Previews of the assistant's reply a company may run each month, through
# POST /api/ai-teaching/dry-run on the AI Teaching screen. A hard platform cap,
# not something a larger plan buys: the preview runs the real model, so every
# press of that button costs money, and before this nothing counted it and
# nothing stopped it. Anyone holding settings.manage could script the endpoint
# and the first evidence would be the invoice.
#
# Set far above real use — tuning an assistant is a few dozen tries, not two
# thousand — so no honest user meets it. Set to 0 to switch the cap off; the
# counting continues either way, under the "ai_previews" metric, separate from
# "ai_replies" so a company's own tests are never billed as conversations.
# Default: 2000
AI_PREVIEW_MAX_PER_PERIOD=2000

# How many assistant previews may run at once, platform-wide. A preview runs the
# real model behind a blocking call that holds a worker thread for the round
# trip; without a ceiling a burst of previews starves the pool every request
# shares and freezes the platform. Excess previews are refused with 429, not
# queued. Default: 6
AI_PREVIEW_MAX_CONCURRENCY=6

# Entries kept in the customer-profile cache before the oldest are evicted.
# Default: 10000
PROFILE_CACHE_MAX_ENTRIES=10000

# How many companies the background sweep opens at once. Each one decrypts and
# opens its own database, so this is the sweep's real cost. Raise it only with
# the model rate limit and the uvicorn worker count in front of you: on a host
# running several workers the true concurrency is this number times the worker
# count. Clamped to 1..64 whatever is set here.
# Default: 8
SWEEP_MAX_CONCURRENT_COMPANIES=8


# -----------------------------------------------------------------------------
# CHANNELS — WhatsApp Cloud API
# -----------------------------------------------------------------------------
# Per-company channel credentials are stored encrypted in the control database
# and managed from the dashboard. The values below are the platform-level
# fallback used for a single-tenant install and for the test endpoints.

# The string you type into Meta's webhook setup form; Meta echoes it back on
# the verification GET. Any long random string works, it just has to match.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Default: v21.0
WHATSAPP_API_VERSION=v21.0


# -----------------------------------------------------------------------------
# CHANNELS — Messenger and Instagram
# -----------------------------------------------------------------------------

META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=
# Default: v21.0
META_API_VERSION=v21.0

# Used to route an inbound webhook to the right account when only one Facebook
# page or Instagram account is connected.
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ID=


# -----------------------------------------------------------------------------
# CHANNELS — Telegram
# -----------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=


# -----------------------------------------------------------------------------
# TELEPHONY — the Dialer
# -----------------------------------------------------------------------------

# The phone line the Dialer places calls on and answers inbound calls with.
# All four values below are needed together. Leave them empty and the Dialer
# stays switched off cleanly: the screen shows a setup notice, every call
# operation answers "telephony is not configured", and nothing else changes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The public https address of this backend, e.g. https://app.example.com.
# Twilio fetches call instructions from it and posts call status and recordings
# back to it, and it is the URL each webhook signature is verified against — so
# it must be the address Twilio was actually configured with, not a proxy's
# internal one.
PUBLIC_BASE_URL=


# -----------------------------------------------------------------------------
# ASSISTANT
# -----------------------------------------------------------------------------

# Master switch for AI replies across the platform. With this off the platform
# still receives and stores messages; only automatic replies stop.
# Default: true
AI_ENABLED=true

OPENAI_API_KEY=
# Default: gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
# Default: https://api.openai.com/v1/responses
OPENAI_API_URL=https://api.openai.com/v1/responses
# Seconds to wait for a completion before giving up and escalating to a human.
# Default: 40
OPENAI_TIMEOUT_SECONDS=40
