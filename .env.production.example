# ============================================================
# Copy this file to .env on the VPS and fill in real values.
# Never commit the real .env — it's already gitignored.
# ============================================================

# --- Domain / deployment ------------------------------------
# The real domain pointed at this VPS (DNS A record must already
# resolve here before starting Caddy, or it can't get a TLS cert).
DOMAIN=app.yourdomain.com

# Same domain, used to bake the API URL into the frontend build.
# Frontend and backend are served from the same domain (Caddy proxies
# /api and /uploads to the backend container), so this is just the
# site's own https URL — no CORS setup needed.
VITE_API_BASE_URL=https://app.yourdomain.com

APP_ENV=production
DEBUG=false

# Must be the same as DOMAIN above, with https:// — used to build
# absolute media URLs that WhatsApp/Telegram/Messenger fetch by URL.
PUBLIC_BACKEND_URL=https://app.yourdomain.com

# Only needed if the frontend is ever hosted on a DIFFERENT domain
# than the backend (not the default setup above). Comma-separated.
# Keep https://localhost and http://localhost in this list — they are the
# origins the T-ZONE Android app (Capacitor WebView) calls the API from.
ALLOWED_ORIGINS=https://app.yourdomain.com,https://localhost,http://localhost

# --- Security --------------------------------------------------
# REQUIRED. Generate a real random secret — do not deploy with the
# default. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# --- WhatsApp Cloud API ------------------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- Telegram -------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Meta (Messenger/Instagram) -----------------------------
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
# Update this in the Meta App dashboard too once deployed.
META_OAUTH_REDIRECT_URI=https://app.yourdomain.com/api/channels/facebook/oauth/callback
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ID=

# --- AI (OpenAI) ------------------------------------------------
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_URL=https://api.openai.com/v1/responses

# --- Email (SMTP) -----------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@tz-lb.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tz-lb.com
SMTP_USE_TLS=true

# --- Database (SQLite, file-based — persisted via a Docker volume,
# no separate database server needed for this scale) -------------
DATABASE_URL=
